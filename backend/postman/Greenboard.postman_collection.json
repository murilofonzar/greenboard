    {
      "name": "Activities - Professor",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{professorToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Criar atividade múltipla escolha com imagem e áudio",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sem upload de áudio, remove o campo para não falhar na validação",
                  "const body = JSON.parse(pm.request.body.raw.replace(/\\{\\{(\\w+)\\}\\}/g, (_, k) => pm.collectionVariables.get(k) ?? ''));",
                  "if (!pm.collectionVariables.get('audioUrl')) {",
                  "  body.media = body.media.filter((m) => m.type !== 'AUDIO');",
                  "  body.questions.forEach((q) => delete q.audioUrl);",
                  "}",
                  "pm.request.body.raw = JSON.stringify(body, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Possui mídias', () => pm.expect(body.media.length).to.be.above(0));",
                  "pm.collectionVariables.set('activityId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Animals - Listen and Choose\",\n  \"description\": \"Ouça o áudio e observe a imagem antes de responder.\",\n  \"type\": \"MULTIPLE_CHOICE\",\n  \"educationLevel\": \"ENSINO_FUNDAMENTAL\",\n  \"gradeGroup\": \"ANOS_FINAIS\",\n  \"grade\": \"OITAVO_ANO\",\n  \"media\": [\n    { \"type\": \"IMAGE\", \"url\": \"{{imageUrl}}\", \"caption\": \"Observe o animal\" },\n    { \"type\": \"AUDIO\", \"url\": \"{{audioUrl}}\", \"caption\": \"Ouça a pronúncia\" }\n  ],\n  \"questions\": [\n    {\n      \"statement\": \"Qual animal aparece na imagem?\",\n      \"options\": [\"Dog\", \"Cat\", \"Bird\", \"Fish\"],\n      \"answer\": 0,\n      \"imageUrl\": \"{{imageUrl}}\"\n    },\n    {\n      \"statement\": \"Qual palavra foi pronunciada no áudio?\",\n      \"options\": [\"House\", \"Dog\", \"Tree\", \"Car\"],\n      \"answer\": 1,\n      \"audioUrl\": \"{{audioUrl}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activities",
              "host": ["{{baseUrl}}"],
              "path": ["activities"]
            }
          }
        },
        {
          "name": "Criar atividade - URL de mídia inválida (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Teste inválido\",\n  \"description\": \"URL javascript não é permitida\",\n  \"educationLevel\": \"ENSINO_FUNDAMENTAL\",\n  \"media\": [{ \"type\": \"IMAGE\", \"url\": \"javascript:alert(1)\" }],\n  \"questions\": [{ \"statement\": \"?\", \"options\": [\"a\", \"b\"], \"answer\": 0 }]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activities",
              "host": ["{{baseUrl}}"],
              "path": ["activities"]
            }
          }
        },
        {
