{
  "info": {
    "name": "Greenboard API",
    "description": "Collection para testes da API Greenboard.\n\nOrdem sugerida: execute as pastas na sequência (Auth → Media → Activities - Professor → Activities - Aluno → Resultados). Os scripts de teste salvam automaticamente tokens, IDs e URLs de mídia nas variáveis da collection.\n\nPara os uploads, selecione um arquivo no campo `file` (form-data) das requisições da pasta Media.\n\nSwagger: {{baseUrl}}/api/docs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "password", "value": "Senha123" },
    { "key": "professorAccessCode", "value": "" },
    { "key": "professorEmail", "value": "" },
    { "key": "studentEmail", "value": "" },
    { "key": "professorToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "activityId", "value": "" },
    { "key": "wordSearchActivityId", "value": "" },
    { "key": "submissionId", "value": "" },
    { "key": "imageUrl", "value": "https://upload.wikimedia.org/wikipedia/commons/2/26/YellowLabradorLooking_new.jpg" },
    { "key": "audioUrl", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Tempo de resposta < 3s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Cadastrar professor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('professorEmail', `professor.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Retorna tokens', () => {",
                  "  pm.expect(body.access_token).to.be.a('string');",
                  "  pm.expect(body.refresh_token).to.be.a('string');",
                  "});",
                  "pm.test('Role PROFESSOR', () => pm.expect(body.user.role).to.eql('PROFESSOR'));",
                  "pm.collectionVariables.set('professorToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Professora Ana\",\n  \"email\": \"{{professorEmail}}\",\n  \"password\": \"{{password}}\",\n  \"birthDate\": \"1985-03-10\",\n  \"accessCode\": \"{{professorAccessCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/professor",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "professor"]
            },
            "description": "Cadastra um professor. `accessCode` só é exigido se `PROFESSOR_REGISTRATION_CODE` estiver configurado no servidor."
          }
        },
        {
          "name": "Cadastrar aluno (Ensino Fundamental)",
