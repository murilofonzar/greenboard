    {
      "name": "Activities - Aluno",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Listar atividades disponíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Sem gabarito para alunos', () => {",
                  "  list.forEach((a) => (a.questions || []).forEach((q) => pm.expect(q).to.not.have.property('answer')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities",
              "host": ["{{baseUrl}}"],
              "path": ["activities"]
            }
          }
        },
        {
          "name": "Obter atividade (com mídias)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
