              "raw": "{\n  \"title\": \"Animals - Listen and Choose (v2)\",\n  \"media\": [\n    { \"type\": \"IMAGE\", \"url\": \"{{imageUrl}}\", \"caption\": \"Imagem atualizada\" }\n  ]\n}"
