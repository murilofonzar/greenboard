# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edu_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Cadastro de professores: se definido, POST /auth/register/professor exige "accessCode" igual a este valor
PROFESSOR_REGISTRATION_CODE=

# Pasta onde imagens/áudios enviados são salvos (servidos em /uploads)
UPLOAD_DIR=uploads
